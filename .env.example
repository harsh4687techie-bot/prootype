# ==========================================
# Portfolio Application - Environment Variables
# ==========================================
# Copy this file to .env and update with your values
# DO NOT commit .env file with sensitive information!

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=4000
NODE_ENV=development
API_VERSION=v1
LOG_LEVEL=info

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# For SQLite
DATABASE_URL="file:./prisma/dev.db"

# For MySQL (if you want to switch)
# DATABASE_URL="mysql://username:password@localhost:3306/portfolio"

# For PostgreSQL (if you want to switch)
# DATABASE_URL="postgresql://username:password@localhost:5432/portfolio"

# ==========================================
# REDIS CONFIGURATION (Optional)
# ==========================================
REDIS_URL="redis://localhost:6379"

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# ADMIN CONFIGURATION
# ==========================================
ADMIN_API_KEY=your-admin-api-key-change-this

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================
# For Testing: Use Ethereal Email (https://ethereal.email/)
# For Production: Use Gmail, SendGrid, AWS SES, etc.

# Ethereal Email (Test Service)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-email@ethereal.email
SMTP_PASS=your-ethereal-password
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Gmail Example (requires "Allow less secure apps" or app-specific password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# SendGrid Example
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# ==========================================
# reCAPTCHA CONFIGURATION (Optional)
# ==========================================
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=your-recaptcha-secret-key
RECAPTCHA_ENABLED=false

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173

# ==========================================
# COOKIE CONFIGURATION
# ==========================================
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
# Set to 'Strict', 'Lax', or 'None' in production
COOKIE_SAME_SITE=Lax

# ==========================================
# RATE LIMITING
# ==========================================
# Rate limit window in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Maximum requests per window
RATE_LIMIT_MAX=100
# Contact form specific rate limit (per minute)
CONTACT_RATE_LIMIT=5

# ==========================================
# SECURITY
# ==========================================
# Enable HTTPS only cookies in production
HTTPS_ONLY=false
# Content Security Policy
CSP_ENABLED=true

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Application name
APP_NAME=Portfolio
# Application URL
APP_URL=http://localhost:3000
# Support email
SUPPORT_EMAIL=support@example.com

# ==========================================
# LOGGING
# ==========================================
# Log location
LOG_DIR=./logs
# Request logging (morgan)
REQUEST_LOG_FORMAT=combined
# Enable request body logging (be careful with sensitive data)
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ==========================================
# FILE UPLOAD
# ==========================================
# Max file upload size in MB
MAX_FILE_SIZE=5
# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# ==========================================
# FEATURES
# ==========================================
# Enable/disable features
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AUTO_REPLY=true
ENABLE_CSV_EXPORT=true
ENABLE_ADMIN_PANEL=true
ENABLE_CONTACT_FORM=true

# ==========================================
# DATABASE BACKUP
# ==========================================
# Enable automatic backups
AUTO_BACKUP_ENABLED=false
# Backup frequency (in hours)
BACKUP_FREQUENCY=24
# Backup retention (in days)
BACKUP_RETENTION=30

# ==========================================
# NOTIFICATIONS (Optional)
# ==========================================
# Slack webhook for errors (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for errors (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ==========================================
# THIRD-PARTY SERVICES
# ==========================================
# Google Analytics ID (optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry Error Tracking (optional)
# SENTRY_DSN=https://...

# ==========================================
# DEVELOPMENT ONLY
# ==========================================
# Seed database on startup (development only)
SEED_DB=false
# Enable request debugging
DEBUG=false
# Mock email sending (don't actually send emails)
MOCK_EMAIL=false

# ==========================================
# DEPLOYMENT
# ==========================================
# For Railway
# RAILWAY_ENVIRONMENT_NAME=production

# For Heroku
# DYNO=web

# ==========================================
# NOTES
# ==========================================
# 1. All SECRET keys should be changed before production
# 2. Use strong, unique values (min 32 characters)
# 3. Store sensitive values in a secure vault
# 4. Never commit this file with real secrets to Git
# 5. Use different values for development and production
# 6. Rotate secrets periodically
